# =========================================================================
# SỔ TAY HT - CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH CHO HOSTING
# =========================================================================

# 1. API Key dịch vụ nhận diện giọng nói (Chọn 1 trong các dịch vụ sau):
# - Khuyên dùng: Gemini API (Miễn phí từ Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# - Hoặc Groq Whisper (Miễn phí từ Groq Console: https://console.groq.com/)
GROQ_API_KEY=

# - Hoặc OpenAI Whisper
OPENAI_API_KEY=

# 2. Cấu hình cơ sở dữ liệu Supabase (Tùy chọn)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Cổng chạy máy chủ (Mặc định 5173 trên máy tính, hoặc do nhà cung cấp hosting cấp)
PORT=5173
